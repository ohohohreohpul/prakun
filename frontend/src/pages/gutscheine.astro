---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header';
import GiftVoucherSection from '../components/GiftVoucherSection';
import GiftBestsellers from '../components/GiftBestsellers';
import Footer from '../components/Footer';
import FloatingPhoneBubble from '../components/FloatingPhoneBubble';
import { localBusinessSchema, breadcrumbSchema, faqSchema } from '../lib/structuredData';

const pageTitle = "Massage Gutschein Hamburg | Prakun Thai Massage – ab 49 €";
const pageDescription = "Gutschein Thai Massage Hamburg ab 49 € – 3 Jahre gültig, sofort digital zugesandt. Perfektes Geschenk für Geburtstag, Muttertag & Weihnachten. ★ 4,9/5 · Prakun Winterhude ✓ Jetzt bestellen!";

const faqItems = [
  {
    question: "Wie kaufe ich einen Massage-Gutschein bei Prakun Hamburg?",
    answer: "Wählen Sie einfach einen Gutscheinbetrag (ab 49 €) auf dieser Seite aus und schließen Sie die Bestellung online ab. Der Gutschein wird sofort digital per E-Mail zugesandt – ideal als Last-Minute-Geschenk. Alternativ können Sie einen Gutschein direkt in unserem Studio am Winterhuder Weg 24 in Hamburg kaufen."
  },
  {
    question: "Wie lange ist ein Massage-Gutschein von Prakun gültig?",
    answer: "Alle Massage-Gutscheine von Prakun Thai Massage Hamburg sind 3 Jahre ab Kaufdatum gültig. Sie können flexibel einen Termin nach Wahl vereinbaren – online oder telefonisch unter 040 22697033. Eine Verlängerung ist nach vorheriger Absprache möglich."
  },
  {
    question: "Welche Massagen kann ich mit einem Gutschein bei Prakun buchen?",
    answer: "Mit einem Prakun-Gutschein können Sie alle angebotenen Massagen buchen: Thai Massage (ab 24 €), Lomi Lomi Massage (ab 72 €), Ayurveda Abhyanga (ab 42 €), Hot Stone Massage (ab 55 €), Aromaöl-Massage (ab 36 €), Fußmassage (ab 35 €), Schwangerschaftsmassage (ab 50 €) und weitere. Der Gutscheinwert ist auf alle Leistungen anrechenbar."
  },
  {
    question: "Kann ich einen Gutschein als Geschenk für andere Personen kaufen?",
    answer: "Ja! Gutscheine sind das beliebteste Geschenk bei Prakun Thai Massage. Ob für Partner, Eltern, Freunde oder Kolleginnen – ein Massage-Gutschein ist immer eine Freude. Der digitale Gutschein enthält ein persönliches Anschreiben und kann sofort per E-Mail oder WhatsApp weitergeleitet werden."
  },
  {
    question: "Was ist ein guter Gutscheinbetrag für eine Thai Massage in Hamburg?",
    answer: "Für eine entspannte 60-Minuten-Massage empfehlen wir den 62-€-Gutschein. Für ein Premium-Erlebnis (z. B. Hot Stone 90 min oder Lomi Lomi 90 min) sind 105 € ideal. Am beliebtesten ist unser 92-€-Gutschein – ausreichend für eine ausgiebige Ganzkörpermassage (90 min). Alle Gutscheine sind auch kombinierbar."
  },
  {
    question: "Kann ich einen Gutschein auch telefonisch oder per E-Mail kaufen?",
    answer: "Ja. Neben der Online-Bestellung können Sie Gutscheine auch telefonisch unter 040 22697033 bestellen oder persönlich in unserem Studio am Winterhuder Weg 24, 22085 Hamburg abholen. Das Studio ist täglich von 10–21 Uhr geöffnet."
  }
];

const breadcrumb = breadcrumbSchema([
  { name: "Home", url: "https://www.prakunthaimassage.de" },
  { name: "Gutscheine", url: "https://www.prakunthaimassage.de/gutscheine" }
]);

const faqStructuredData = faqSchema(faqItems);

const giftCardSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Massage Gutschein Hamburg – Prakun Thai Massage",
  "description": "Wertgutschein für alle Massageleistungen bei Prakun Thai Massage Hamburg. 3 Jahre gültig, digital zugesandt.",
  "brand": {
    "@type": "Brand",
    "name": "Prakun Thai Massage Hamburg"
  },
  "offers": [
    {
      "@type": "Offer",
      "name": "Gutschein 49 €",
      "price": "49.00",
      "priceCurrency": "EUR",
      "availability": "https://schema.org/InStock",
      "url": "https://www.prakunthaimassage.de/gutscheine"
    },
    {
      "@type": "Offer",
      "name": "Gutschein 62 €",
      "price": "62.00",
      "priceCurrency": "EUR",
      "availability": "https://schema.org/InStock",
      "url": "https://www.prakunthaimassage.de/gutscheine"
    },
    {
      "@type": "Offer",
      "name": "Gutschein 92 €",
      "price": "92.00",
      "priceCurrency": "EUR",
      "availability": "https://schema.org/InStock",
      "url": "https://www.prakunthaimassage.de/gutscheine"
    },
    {
      "@type": "Offer",
      "name": "Gutschein 114 €",
      "price": "114.00",
      "priceCurrency": "EUR",
      "availability": "https://schema.org/InStock",
      "url": "https://www.prakunthaimassage.de/gutscheine"
    }
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "200",
    "bestRating": "5"
  }
};

const allStructuredData = [localBusinessSchema, faqStructuredData, giftCardSchema, breadcrumb];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  keywords="Gutschein Massage Hamburg, Gutschein Thaimassage Hamburg, Thai Massage Gutschein Hamburg, Massage Gutschein kaufen, Gutschein Wellness Hamburg, Geschenk Massage Hamburg, Gutschein Thai Massage"
  structuredData={allStructuredData}
>
  <Header client:load />
  <main>
    <!-- Hero section for Gutschein page -->
    <section class="relative pt-24 pb-12 bg-gradient-to-b from-[#1a1a1a] to-[#2a1a24] text-white overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="text-[#c9a96e] text-sm font-semibold uppercase tracking-widest mb-4">Prakun Thai Massage Hamburg</p>
        <h1 class="text-4xl md:text-5xl font-bold mb-6 leading-tight">
          Massage Gutschein Hamburg
        </h1>
        <p class="text-xl text-white/75 max-w-2xl mx-auto mb-8">
          Verschenken Sie Entspannung: Gutscheine ab 49 € für alle Massagen – 3 Jahre gültig, sofort digital. Das perfekte Geschenk für jeden Anlass.
        </p>
        <div class="flex flex-wrap justify-center gap-4 text-sm text-white/60">
          <span>✓ Ab 49 € – flexibel wählbar</span>
          <span>✓ 3 Jahre gültig</span>
          <span>✓ Sofort per E-Mail</span>
          <span>✓ 4,9★ aus 200+ Bewertungen</span>
        </div>
      </div>
    </section>

    <!-- Reuse existing gift voucher components -->
    <GiftVoucherSection client:load />
    <GiftBestsellers client:visible />

    <!-- SEO text + FAQ section -->
    <section class="py-16 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="prose prose-lg max-w-none mb-16">
          <h2 class="text-2xl font-bold text-[#1a1a1a] mb-4">Massage Gutschein Hamburg – Das ideale Geschenk</h2>
          <p class="text-gray-600 mb-4">
            Suchen Sie ein besonderes Geschenk in Hamburg? Ein Massage-Gutschein von Prakun Thai Massage ist die perfekte Wahl: persönlich, wertvoll und nachhaltig. Seit 2012 schenken wir in Winterhude Entspannung – mit über 10.000 zufriedenen Gästen und einer Google-Bewertung von 4,9 Sternen.
          </p>
          <p class="text-gray-600 mb-4">
            Unsere Gutscheine sind für alle Massageleistungen einlösbar: von der klassischen Thai Massage (ab 24 €) über die Lomi Lomi Nui Massage (ab 72 €) bis hin zur Hot Stone Massage (ab 55 €) und Ayurveda Abhyanga (ab 42 €). Ob 30 Minuten oder 2 Stunden – Sie wählen den Betrag, der Beschenkte wählt die Massage.
          </p>
          <h3 class="text-xl font-semibold text-[#1a1a1a] mt-8 mb-3">Warum ein Massage-Gutschein aus Hamburg?</h3>
          <ul class="text-gray-600 space-y-2 mb-6">
            <li><strong>Sofort verfügbar:</strong> Digitaler Gutschein per E-Mail – auch als Last-Minute-Geschenk geeignet.</li>
            <li><strong>Flexibel einlösbar:</strong> Für jede Massage, jeden Therapeuten, jede Dauer.</li>
            <li><strong>3 Jahre gültig:</strong> Keine Hektik – der Beschenkte bucht, wann er möchte.</li>
            <li><strong>Zertifizierte Therapeuten:</strong> Alle Masseure sind ausgebildet und langjährig erfahren.</li>
            <li><strong>Zentrale Lage:</strong> Winterhuder Weg 24, Hamburg – gut erreichbar per U-Bahn (Mundsburg, U3).</li>
          </ul>
          <p class="text-gray-600">
            Gutscheine eignen sich hervorragend als <strong>Geburtstagsgeschenk</strong>, zum <strong>Muttertag</strong>, zu <strong>Weihnachten</strong>, als <strong>Jubiläumsgeschenk</strong> oder einfach als Dankeschön. Bestellen Sie jetzt online oder besuchen Sie uns direkt im Studio.
          </p>
        </div>

        <!-- FAQ -->
        <div>
          <h2 class="text-2xl font-bold text-[#1a1a1a] mb-8">Häufige Fragen zu Massage-Gutscheinen in Hamburg</h2>
          <div class="space-y-6">
            {faqItems.map((item, i) => (
              <div class="border-b border-gray-100 pb-6">
                <h3 class="font-semibold text-[#1a1a1a] mb-2">{item.question}</h3>
                <p class="text-gray-600 leading-relaxed">{item.answer}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Internal links to related pages -->
        <div class="mt-12 pt-8 border-t border-gray-100">
          <h3 class="text-lg font-semibold text-[#1a1a1a] mb-4">Alle Massagen bei Prakun Thai Massage Hamburg</h3>
          <div class="flex flex-wrap gap-3 text-sm">
            <a href="/massage/thai-massage" class="text-[#7B2958] hover:underline">Thai Massage Hamburg</a>
            <a href="/massage/lomi-lomi-massage" class="text-[#7B2958] hover:underline">Lomi Lomi Massage Hamburg</a>
            <a href="/massage/hot-stone-massage" class="text-[#7B2958] hover:underline">Hot Stone Massage Hamburg</a>
            <a href="/massage/ayurveda-abhyanga" class="text-[#7B2958] hover:underline">Ayurveda Abhyanga Hamburg</a>
            <a href="/massage/aromaoel-massage" class="text-[#7B2958] hover:underline">Aromaöl Massage Hamburg</a>
            <a href="/massage/fussmassage" class="text-[#7B2958] hover:underline">Fußmassage Hamburg</a>
            <a href="/massage/schwangerschaftsmassage" class="text-[#7B2958] hover:underline">Schwangerschaftsmassage Hamburg</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer client:visible />
  <FloatingPhoneBubble client:load phoneNumber="040 22697033" />
</BaseLayout>
