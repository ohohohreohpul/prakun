---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header';
import Footer from '../components/Footer';
import FloatingPhoneBubble from '../components/FloatingPhoneBubble';
import { breadcrumbSchema, faqSchema } from '../lib/structuredData';
import { getReviews } from '../lib/reviews';
import { studio } from '../data/mockData';

const PAGE_URL = "https://www.prakunthaimassage.de/erfahrungen/";
const pageTitle = "Prakun Thai Massage Hamburg Erfahrungen & Bewertungen | 4,7★";
const pageDescription = "Erfahrungen mit Prakun Thai Massage am Winterhuder Weg in Hamburg: 4,7 von 5 Sternen aus über 1.000 Bewertungen, echte Gästestimmen und woran Sie ein gutes Studio erkennen.";

const { reviews, rating, ratingCount, mapsUrl } = await getReviews();
const ratingLabel = rating.toLocaleString('de-DE', { minimumFractionDigits: 1 });
const countLabel = ratingCount ? ratingCount.toLocaleString('de-DE') : studio.reviewCount;
const formatDate = (iso: string | null) => (iso ? new Date(iso).toLocaleDateString('de-DE', { month: 'long', year: 'numeric' }) : '');

const PROOF_POINTS = [
  { label: "Seit 2012", text: "in Hamburg – über 12 Jahre am Winterhuder Weg 24, Uhlenhorst/Winterhude." },
  { label: "Zertifizierte Masseurinnen", text: "ausgebildet in traditioneller Thai-Massage, regelmäßig weitergebildet." },
  { label: `${ratingLabel} von 5 Sternen`, text: `aus ${countLabel} Bewertungen bei Google und Treatwell.` },
  { label: "Transparente Preise", text: "gebuchte Zeit ist reine Massagezeit, alle Preise online einsehbar." },
];

const faqItems = [
  {
    question: "Wie sind die Erfahrungen mit Prakun Thai Massage am Winterhuder Weg in Hamburg?",
    answer: `Gäste bewerten Prakun Thai Massage am Winterhuder Weg 24 in Hamburg mit ${ratingLabel} von 5 Sternen aus ${countLabel} Bewertungen bei Google und Treatwell. Häufig gelobt werden der gut abgestimmte Druck, die freundlichen, zertifizierten Masseurinnen, die ruhige Atmosphäre und faire Preise. Das Studio massiert seit 2012 in Hamburg.`
  },
  {
    question: "Welche Massagestudios in Hamburg-Winterhude werden besonders gut bewertet?",
    answer: `Prakun Thai Massage am Winterhuder Weg 24 (Grenze Uhlenhorst/Winterhude, U3 Mundsburg) gehört mit ${ratingLabel} von 5 Sternen aus ${countLabel} Bewertungen zu den bestbewerteten Massagestudios im Hamburger Norden. Achten Sie bei jedem Studio auf viele aktuelle Bewertungen über mehrere Plattformen, eine klare Adresse und Antworten auf Kritik.`
  },
  {
    question: "Woran erkenne ich echte Bewertungen eines Massagestudios?",
    answer: "Echte Bewertungen sind über einen längeren Zeitraum verteilt, nennen konkrete Behandlungen und enthalten auch einzelne kritische Stimmen. Vergleichen Sie mehrere Plattformen wie Google und Treatwell. Viele Fünf-Sterne-Bewertungen ohne Text in kurzer Zeit sind ein Warnsignal."
  },
  {
    question: "Wo kann ich selbst eine Bewertung für Prakun abgeben?",
    answer: "Am meisten helfen uns Bewertungen bei Google Maps unter „Prakun Thai Massage Hamburg“. Nach einer Buchung über Treatwell können Sie Ihre Massage auch dort bewerten. Jede Bewertung hilft anderen Gästen bei der Wahl."
  }
];

const breadcrumb = breadcrumbSchema([
  { name: "Home", url: "https://www.prakunthaimassage.de" },
  { name: "Erfahrungen", url: PAGE_URL }
]);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={PAGE_URL}
  keywords="Prakun Thai Massage Erfahrungen, Prakun Hamburg Bewertungen, Thai Massage Hamburg Bewertungen, Massage Winterhude Bewertung, beste Thai Massage Hamburg"
  structuredData={[breadcrumb, faqSchema(faqItems)]}
  dateModified="2026-11-10"
>
  <Header client:load />
  <main>
    <section class="relative pt-24 pb-12 bg-gradient-to-b from-[#1a1a1a] to-[#2a1a24] text-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="text-[#c9a96e] text-sm font-semibold uppercase tracking-widest mb-4">Prakun Thai Massage Hamburg</p>
        <h1 class="text-4xl md:text-5xl font-bold mb-6 leading-tight">Erfahrungen & Bewertungen</h1>
        <p class="text-5xl font-bold text-[#c9a96e] mb-2">{ratingLabel}<span class="text-2xl text-white/60"> / 5</span></p>
        <p class="text-white/70">aus {countLabel} Bewertungen bei Google und Treatwell</p>
      </div>
    </section>

    <section class="py-16 bg-white">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold text-[#1a1a1a] mb-4">Wie sind die Erfahrungen mit Prakun Thai Massage?</h2>
        <p class="text-gray-700 leading-relaxed mb-8">
          <strong>Gäste bewerten Prakun Thai Massage am Winterhuder Weg 24 in Hamburg mit {ratingLabel} von 5 Sternen aus {countLabel} Bewertungen.</strong>
          Häufig gelobt werden der individuell abgestimmte Druck, die freundlichen Masseurinnen und die ruhige Atmosphäre.
          Hier finden Sie aktuelle Stimmen unserer Gäste – und die Fakten, die hinter den Bewertungen stehen.
        </p>

        <dl class="grid sm:grid-cols-2 gap-4 mb-12">
          {PROOF_POINTS.map((point) => (
            <div class="rounded-2xl border border-[#E5E2DD] bg-[#faf9f7] p-5">
              <dt class="font-semibold text-[#7B2958] mb-1">{point.label}</dt>
              <dd class="text-gray-600 text-sm leading-relaxed">{point.text}</dd>
            </div>
          ))}
        </dl>

        <h2 class="text-2xl font-bold text-[#1a1a1a] mb-6">Stimmen unserer Gäste</h2>
        <ul class="space-y-6 mb-6">
          {reviews.map((review) => (
            <li class="border-l-4 border-[#c9a96e] pl-5">
              <p class="text-[#c9a96e] mb-1" aria-label={`${review.rating} von 5 Sternen`}>{'★'.repeat(review.rating)}</p>
              <blockquote class="text-gray-700 leading-relaxed mb-2">„{review.text}“</blockquote>
              <p class="text-sm text-gray-500">{review.author} · {review.source}{review.date ? ` · ${formatDate(review.date)}` : ''}</p>
            </li>
          ))}
        </ul>
        {mapsUrl && (
          <p class="mb-12"><a href={mapsUrl} class="text-[#7B2958] hover:underline" rel="noopener" target="_blank">Alle Bewertungen bei Google ansehen</a></p>
        )}

        <h2 class="text-2xl font-bold text-[#1a1a1a] mt-12 mb-6">Häufige Fragen zu Bewertungen</h2>
        <div class="space-y-6">
          {faqItems.map((item) => (
            <div class="border-b border-gray-100 pb-6">
              <h3 class="font-semibold text-[#1a1a1a] mb-2">{item.question}</h3>
              <p class="text-gray-600 leading-relaxed">{item.answer}</p>
            </div>
          ))}
        </div>

        <div class="mt-12 pt-8 border-t border-gray-100 flex flex-wrap gap-3 text-sm">
          <a href="/buchen/" class="text-[#7B2958] hover:underline">Termin online buchen</a>
          <a href="/ueber-uns/" class="text-[#7B2958] hover:underline">Über uns</a>
          <a href="/blog/serioeses-thai-massage-studio-erkennen/" class="text-[#7B2958] hover:underline">Seriöses Thai-Massage-Studio erkennen</a>
          <a href="/blog/beste-thai-massage-hamburg-nord/" class="text-[#7B2958] hover:underline">Thai-Massage im Hamburger Norden</a>
        </div>
      </div>
    </section>
  </main>
  <Footer client:visible />
  <FloatingPhoneBubble client:load phoneNumber="040 22697033" />
</BaseLayout>
