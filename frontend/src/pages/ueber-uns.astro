---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header';
import AboutPage from '../components/AboutPage';
import Footer from '../components/Footer';
import FloatingPhoneBubble from '../components/FloatingPhoneBubble';
import { breadcrumbSchema, organizationSchema, founderSchema, localBusinessSchema } from '../lib/structuredData';

const pageTitle = "Über uns – Prakun Thai Massage Hamburg seit 2012 | Unsere Geschichte";
const pageDescription = "Prakun bedeutet Dankbarkeit auf Thai. Seit 2012 bringen wir authentische Thai-Massage-Kunst aus Thailand nach Hamburg-Winterhude. 100% zertifizierte Therapeuten, 10.000+ zufriedene Gäste.";

const breadcrumb = breadcrumbSchema([
  { name: "Home", url: "https://www.prakunthaimassage.de" },
  { name: "Über uns", url: "https://www.prakunthaimassage.de/ueber-uns" }
]);

const allStructuredData = [localBusinessSchema, organizationSchema, founderSchema, breadcrumb];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  keywords="Thai Massage Hamburg Geschichte, Prakun Hamburg, Thai Massage Winterhude, zertifizierte Therapeuten Hamburg, authentische Thai Massage"
  structuredData={allStructuredData}
>
  <Header client:load />
  <AboutPage client:visible />
  <Footer client:visible />
  <FloatingPhoneBubble client:load phoneNumber="040 22697033" />
</BaseLayout>
