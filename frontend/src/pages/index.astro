---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header';
import HeroSection from '../components/HeroSection';
import ServiceCards from '../components/ServiceCards';
import BenefitsSection from '../components/BenefitsSection';
import MembershipSection from '../components/MembershipSection';
import StudioLocations from '../components/StudioLocations';
import LymphaticSection from '../components/LymphaticSection';
import Testimonials from '../components/Testimonials';
import GiftVoucherSection from '../components/GiftVoucherSection';
import GiftBestsellers from '../components/GiftBestsellers';
import FAQSection from '../components/FAQSection';
import Footer from '../components/Footer';
import MonthlyOfferPopup from '../components/MonthlyOfferPopup';
import FloatingPhoneBubble from '../components/FloatingPhoneBubble';
import { localBusinessSchema, faqSchema, reviewSchema, siteLinksSearchBoxSchema } from '../lib/structuredData';
import { faqItems, testimonials } from '../data/mockData';

const pageTitle = "Thai Massage Hamburg ab 24 € | Prakun ★ 4,9/5 · 200+ Bewertungen";
const pageDescription = "Massage Hamburg & Thaimassage ab 24 € – Prakun Winterhude ★ 4,9/5 (200+ Bewertungen). Zertifizierte Therapeuten, Gutscheine verfügbar. Täglich geöffnet. ✓ Jetzt buchen!";

const faqStructuredData = faqSchema(faqItems.map(faq => ({
  question: faq.question,
  answer: faq.answer
})));

const reviewStructuredData = reviewSchema(testimonials.map(t => ({
  author: t.author,
  rating: t.rating,
  text: t.text
})));

const allStructuredData = [localBusinessSchema, siteLinksSearchBoxSchema, faqStructuredData, reviewStructuredData];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  keywords="Thai Massage Hamburg, Thaimassage Hamburg, Massage Hamburg, Thaimassage in der Nähe, Lomi Lomi Massage Hamburg, Fußmassage Hamburg, Gutschein Thai Massage Hamburg, Hot Stone Massage Hamburg, Ayurveda Hamburg, Ganzkörpermassage Hamburg, Teilkörpermassage Hamburg"
  structuredData={allStructuredData}
>
  <Header client:load />
  <main>
    <HeroSection client:load />
    <ServiceCards client:visible />
    <BenefitsSection client:visible />
    <MembershipSection client:visible />
    <StudioLocations client:visible />
    <LymphaticSection client:visible />
    <Testimonials client:visible />
    <GiftVoucherSection client:visible />
    <GiftBestsellers client:visible />
    <FAQSection client:visible />

    <!-- SEO text block: targeting "Massage Hamburg", neighborhood, and local service keywords -->
    <section class="py-14 bg-[#faf9f7]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold text-[#1a1a1a] mb-4">Massage Hamburg – Ihr Wohlbefinden im Zentrum</h2>
        <p class="text-gray-600 mb-4 leading-relaxed">
          Prakun Thai Massage ist Ihre professionelle Massage-Adresse in Hamburg. Seit 2012 bieten wir in unserem Studio am Winterhuder Weg 24 in Hamburg-Winterhude authentische Thai-Massagen, Lomi-Lomi-, Ayurveda- und Hot-Stone-Behandlungen, Aromaöl-Massagen sowie viele weitere Wellnessleistungen an – durchgeführt von 100 % zertifizierten Therapeuten, die ihre Ausbildung überwiegend in Thailand absolviert haben. Mit einer Google-Bewertung von 4,9 von 5 Sternen aus über 200 Bewertungen zählt Prakun zu den bestbewerteten Massage-Studios in Hamburg. Die Preise beginnen bei 24 € für eine 20-minütige Teilkörpermassage; eine Ganzkörpermassage gibt es ab 49 €. Termine lassen sich in unter einer Minute online buchen oder telefonisch unter 040 22697033 vereinbaren – kostenlose Stornierung bis 24 Stunden vor dem Termin inklusive.
        </p>
        <p class="text-gray-600 mb-6 leading-relaxed">
          Ob Sie nach einer klassischen <strong>Thaimassage</strong>, einer entspannenden Öl-Massage oder einer kraftvollen Hot-Stone-Behandlung suchen: Als zentral gelegenes Massage-Studio in Hamburg erreichen uns Gäste aus ganz Hamburg schnell und einfach – per U-Bahn (U3, Haltestelle Mundsburg), per Fahrrad oder mit dem Auto. Wir sind täglich geöffnet: Montag bis Freitag von 10 bis 20 Uhr, samstags von 10 bis 18 Uhr und sonntags von 11 bis 17 Uhr.
        </p>

        <!-- Semantic price table: machine-extractable for search/AI parsers -->
        <h3 class="text-lg font-semibold text-[#1a1a1a] mb-3">Massage Hamburg Preise – Übersicht</h3>
        <div class="overflow-x-auto mb-8">
          <table class="w-full text-sm text-left border-collapse">
            <caption class="sr-only">Preise für Massagen bei Prakun Thai Massage Hamburg</caption>
            <thead>
              <tr class="border-b border-gray-300">
                <th scope="col" class="py-2 pr-4 font-semibold text-[#1a1a1a]">Massage</th>
                <th scope="col" class="py-2 pr-4 font-semibold text-[#1a1a1a]">Dauer</th>
                <th scope="col" class="py-2 font-semibold text-[#1a1a1a]">Preis</th>
              </tr>
            </thead>
            <tbody class="text-gray-600">
              <tr class="border-b border-gray-200">
                <td class="py-2 pr-4"><a href="/massage/teilkoerpermassage" class="text-[#7B2958] hover:underline">Teilkörpermassage</a></td>
                <td class="py-2 pr-4">20–60 Min.</td>
                <td class="py-2">ab 24 €</td>
              </tr>
              <tr class="border-b border-gray-200">
                <td class="py-2 pr-4"><a href="/massage/aromaoel-massage" class="text-[#7B2958] hover:underline">Aromaöl-Massage</a></td>
                <td class="py-2 pr-4">30–120 Min.</td>
                <td class="py-2">ab 36 €</td>
              </tr>
              <tr class="border-b border-gray-200">
                <td class="py-2 pr-4"><a href="/massage/ganzkoerpermassage" class="text-[#7B2958] hover:underline">Ganzkörpermassage</a></td>
                <td class="py-2 pr-4">45–120 Min.</td>
                <td class="py-2">ab 49 €</td>
              </tr>
              <tr class="border-b border-gray-200">
                <td class="py-2 pr-4"><a href="/massage/hot-stone-massage" class="text-[#7B2958] hover:underline">Hot Stone Massage</a></td>
                <td class="py-2 pr-4">45–120 Min.</td>
                <td class="py-2">ab 55 €</td>
              </tr>
              <tr class="border-b border-gray-200">
                <td class="py-2 pr-4"><a href="/massage/lomi-lomi-massage" class="text-[#7B2958] hover:underline">Lomi Lomi Massage</a></td>
                <td class="py-2 pr-4">60–120 Min.</td>
                <td class="py-2">ab 72 €</td>
              </tr>
              <tr>
                <td class="py-2 pr-4"><a href="/massage/schwangerschaftsmassage" class="text-[#7B2958] hover:underline">Schwangerschaftsmassage</a></td>
                <td class="py-2 pr-4">45–90 Min.</td>
                <td class="py-2">ab 50 €</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Neighborhood service links -->
        <h3 class="text-lg font-semibold text-[#1a1a1a] mb-3">Thai Massage in Ihrer Nähe</h3>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2 mb-8">
          <a href="/thai-massage-winterhude" class="text-sm text-[#7B2958] hover:underline py-1">Thai Massage Winterhude</a>
          <a href="/thai-massage-barmbek" class="text-sm text-[#7B2958] hover:underline py-1">Thai Massage Barmbek</a>
          <a href="/thai-massage-eppendorf" class="text-sm text-[#7B2958] hover:underline py-1">Thai Massage Eppendorf</a>
          <a href="/thai-massage-uhlenhorst" class="text-sm text-[#7B2958] hover:underline py-1">Thai Massage Uhlenhorst</a>
          <a href="/thai-massage-eilbek" class="text-sm text-[#7B2958] hover:underline py-1">Thai Massage Eilbek</a>
          <a href="/thai-massage-wandsbek" class="text-sm text-[#7B2958] hover:underline py-1">Thai Massage Wandsbek</a>
          <a href="/thai-massage-alsterdorf" class="text-sm text-[#7B2958] hover:underline py-1">Thai Massage Alsterdorf</a>
          <a href="/leistungen" class="text-sm text-[#7B2958] hover:underline py-1">Alle Massagen ansehen →</a>
        </div>

        <!-- Quick links to all services -->
        <h3 class="text-lg font-semibold text-[#1a1a1a] mb-3">Unsere Massagen in Hamburg</h3>
        <div class="flex flex-wrap gap-3">
          <a href="/massage/thai-massage" class="text-sm bg-white border border-gray-200 rounded-full px-3 py-1 text-gray-700 hover:border-[#7B2958] hover:text-[#7B2958] transition-colors">Thai Massage</a>
          <a href="/massage/lomi-lomi-massage" class="text-sm bg-white border border-gray-200 rounded-full px-3 py-1 text-gray-700 hover:border-[#7B2958] hover:text-[#7B2958] transition-colors">Lomi Lomi Massage</a>
          <a href="/massage/hot-stone-massage" class="text-sm bg-white border border-gray-200 rounded-full px-3 py-1 text-gray-700 hover:border-[#7B2958] hover:text-[#7B2958] transition-colors">Hot Stone Massage</a>
          <a href="/massage/ayurveda-abhyanga" class="text-sm bg-white border border-gray-200 rounded-full px-3 py-1 text-gray-700 hover:border-[#7B2958] hover:text-[#7B2958] transition-colors">Ayurveda Abhyanga</a>
          <a href="/massage/aromaoel-massage" class="text-sm bg-white border border-gray-200 rounded-full px-3 py-1 text-gray-700 hover:border-[#7B2958] hover:text-[#7B2958] transition-colors">Aromaöl Massage</a>
          <a href="/massage/fussmassage" class="text-sm bg-white border border-gray-200 rounded-full px-3 py-1 text-gray-700 hover:border-[#7B2958] hover:text-[#7B2958] transition-colors">Fußmassage</a>
          <a href="/massage/schwangerschaftsmassage" class="text-sm bg-white border border-gray-200 rounded-full px-3 py-1 text-gray-700 hover:border-[#7B2958] hover:text-[#7B2958] transition-colors">Schwangerschaftsmassage</a>
          <a href="/gutscheine" class="text-sm bg-white border border-gray-200 rounded-full px-3 py-1 text-gray-700 hover:border-[#7B2958] hover:text-[#7B2958] transition-colors">Massage Gutschein</a>
        </div>
      </div>
    </section>
  </main>
  <Footer client:visible />
  <MonthlyOfferPopup client:load />
  <FloatingPhoneBubble client:load phoneNumber="040 22697033" />
</BaseLayout>
