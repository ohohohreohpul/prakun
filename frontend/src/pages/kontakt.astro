---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header';
import ContactPage from '../components/ContactPage';
import Footer from '../components/Footer';
import FloatingPhoneBubble from '../components/FloatingPhoneBubble';
import { breadcrumbSchema, localBusinessSchema, organizationSchema } from '../lib/structuredData';

const pageTitle = "Kontakt – Thai Massage Hamburg | Prakun Thai Massage Winterhude";
const pageDescription = "Prakun Thai Massage Hamburg – Winterhuder Weg 24, 22085 Hamburg. Tel: 040 22697033. Täglich geöffnet: Mo–Fr 10–20, Sa 10–18, So 11–17 Uhr. Jetzt Termin anfragen oder online buchen!";

const breadcrumb = breadcrumbSchema([
  { name: "Home", url: "https://www.prakunthaimassage.de" },
  { name: "Kontakt", url: "https://www.prakunthaimassage.de/kontakt" }
]);

const allStructuredData = [localBusinessSchema, organizationSchema, breadcrumb];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  structuredData={allStructuredData}
>
  <Header client:load />
  <ContactPage client:visible />
  <Footer client:visible />
  <FloatingPhoneBubble client:load phoneNumber="040 22697033" />
</BaseLayout>
