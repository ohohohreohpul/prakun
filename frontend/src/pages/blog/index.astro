---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header';
import Footer from '../../components/Footer';
import FloatingPhoneBubble from '../../components/FloatingPhoneBubble';
import { breadcrumbSchema } from '../../lib/structuredData';
import { formatGermanDate, readingMinutes } from '../../lib/blog';

const PAGE_URL = "https://www.prakunthaimassage.de/blog/";
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Massage-Ratgeber von Prakun Thai Massage Hamburg",
  "itemListElement": posts.map((post, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "url": `${PAGE_URL}${post.id}/`,
    "name": post.data.title
  }))
};

const breadcrumb = breadcrumbSchema([
  { name: "Home", url: "https://www.prakunthaimassage.de" },
  { name: "Ratgeber", url: PAGE_URL }
]);
---

<BaseLayout
  title="Massage-Ratgeber: Thai-Massage, Wirkung & Preise | Prakun Hamburg"
  description="Antworten unserer Thai-Masseurinnen aus Hamburg: Ablauf, Wirkung, Preise und was nach der Massage normal ist. Ratgeber von Prakun Thai Massage seit 2012."
  canonicalUrl={PAGE_URL}
  structuredData={[itemList, breadcrumb]}
  pageType="CollectionPage"
>
  <Header client:load />
  <main class="bg-[#F7F6F4]">
    <header class="relative overflow-hidden bg-gradient-to-b from-[#1a1a1a] to-[#2a1a24] text-white pt-32 pb-16">
      <div aria-hidden="true" class="pointer-events-none absolute -left-24 -bottom-32 h-80 w-80 rounded-full bg-[#7B2958]/30 blur-3xl"></div>
      <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-[#C4A77D] text-xs font-semibold uppercase tracking-[0.2em] mb-4">Prakun Thai Massage Hamburg</p>
        <h1 class="text-4xl md:text-6xl font-bold leading-[1.05] mb-5">Massage-Ratgeber</h1>
        <p class="text-lg text-white/70 max-w-2xl">Was Gäste uns im Studio am häufigsten fragen – beantwortet von unserem Team in Hamburg-Uhlenhorst.</p>
      </div>
    </header>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
      <ul class="grid gap-6 md:grid-cols-2">
        {posts.map((post, index) => (
          <li class={index === 0 ? 'md:col-span-2' : ''}>
            <article class="group relative flex h-full flex-col rounded-2xl bg-white border border-[#E5E2DD] p-7 md:p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-[#7B2958]/10">
              <p class="flex flex-wrap items-center gap-x-3 text-sm text-gray-500 mb-4">
                <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{formatGermanDate(post.data.pubDate)}</time>
                <span aria-hidden="true" class="h-1 w-1 rounded-full bg-[#C4A77D]"></span>
                <span>{readingMinutes(post.body)} Min. Lesezeit</span>
              </p>
              <h2 class={`font-bold text-[#1a1a1a] leading-tight mb-3 [text-wrap:balance] group-hover:text-[#7B2958] transition-colors ${index === 0 ? 'text-2xl md:text-3xl' : 'text-xl md:text-2xl'}`}>
                <a href={`/blog/${post.id}/`} class="after:absolute after:inset-0 after:rounded-2xl focus-visible:outline-none focus-visible:after:outline focus-visible:after:outline-2 focus-visible:after:outline-[#7B2958]">{post.data.title}</a>
              </h2>
              <p class="text-gray-600 leading-relaxed mb-6 flex-1">{post.data.description}</p>
              <span class="inline-flex items-center gap-2 text-[#7B2958] font-semibold">
                Weiterlesen
                <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
              </span>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </main>
  <Footer client:visible />
  <FloatingPhoneBubble client:load phoneNumber="040 22697033" />
</BaseLayout>
