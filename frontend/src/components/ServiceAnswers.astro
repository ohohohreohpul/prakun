---
import { serviceAnswers } from '../data/serviceAnswers';

interface Props {
  title: string;
  slug: string;
  faq: Array<{ question: string; answer: string }>;
}

const { title, slug, faq } = Astro.props;
interface ServiceAnswer {
  whatIs: string;
  suitableFor: string;
}

const answer: ServiceAnswer | undefined = (serviceAnswers as Record<string, ServiceAnswer>)[slug];
---

<section class="py-16 bg-[#faf9f7]" aria-labelledby="service-answers-heading">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    {answer && (
      <>
        <h2 id="service-answers-heading" class="text-2xl font-bold text-[#1a1a1a] mb-4">Was ist eine {title}?</h2>
        <p class="text-gray-700 leading-relaxed mb-10">{answer.whatIs}</p>
      </>
    )}
    <h2 class="text-2xl font-bold text-[#1a1a1a] mb-6">{title} in Hamburg – häufige Fragen</h2>
    <div class="space-y-6">
      {faq.map((item) => (
        <div>
          <h3 class="text-lg font-semibold text-[#1a1a1a] mb-2">{item.question}</h3>
          <p class="text-gray-600 leading-relaxed">{item.answer}</p>
        </div>
      ))}
    </div>
  </div>
</section>
